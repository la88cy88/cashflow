# GitHub Actions 版自动部署配置（可选）。
#
# 当前站点使用 GitHub Pages 的「分支发布」（main 根目录），推送即生效。
# 如需切换到 Actions 发布：
#   1. 把本文件重命名为 deploy.yml
#   2. 仓库 Settings → Pages → Build and deployment → Source 选 GitHub Actions
#   3. 推送
# 注意：推送 .github/workflows/*.yml 需要凭据具备 workflow 权限；
#       仅有 repo 权限的令牌会被 GitHub 拒绝，所以这里先以 .example 保留。

name: Deploy to GitHub Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Configure Pages
        uses: actions/configure-pages@v5

      - name: Assemble site bundle
        run: |
          mkdir -p _site
          cp -R index.html manifest.webmanifest sw.js css js icons _site/

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: _site

      - name: Deploy
        id: deployment
        uses: actions/deploy-pages@v4
